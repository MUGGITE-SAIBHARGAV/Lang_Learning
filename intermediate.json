    {
      "title": "Lesson 1: Making Small Talk",
      "content": [
        "Grammar: Present Simple vs Present Continuous",
        "Vocabulary: weather, hobbies, small talk phrases",
        "Conversation: 'Hi! Nice weather today, isn’t it?' 'Yeah, it’s perfect for a walk.'"
      ],
      "exercises": [
        {
          "type": "multiple_choice",
          "question": "Which sentence is in present continuous?",
          "options": ["I read a book.", "She is reading a book.", "He read a book.", "They have books."],
          "answer": "She is reading a book."
        },
        {
          "type": "fill_in_the_blank",
          "question": "It _______ (rain) right now.",
          "answer": "is raining"
        },
        {
          "type": "matching",
          "question": "Match the phrase with its meaning",
          "pairs": {
            "Nice to meet you": "Greeting when introduced",
            "How’s it going?": "Informal way to ask how someone is",
            "Lovely weather": "Talking about the weather"
          }
        },
        {
          "type": "fill_in_the_blank",
          "question": "She usually _______ (go) for a walk in the evening.",
          "answer": "goes"
        },
        {
          "type": "multiple_choice",
          "question": "What topic is common in small talk?",
          "options": ["Politics", "Weather", "Finances", "Homework"],
          "answer": "Weather"
        }
      ]
    },
    {
